# Block PHP execution inside the uploads folder
<FilesMatch "\.(?i:php|phtml|php3|php4|php5)$">
    Require all denied
</FilesMatch>

# Cache uploaded images in the browser (filenames are stable, so caching is safe)
<IfModule mod_headers.c>
    <FilesMatch "\.(?i:jpg|jpeg|png|gif|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
